{
  "name": "quest-checkin",
  "private": true,
  "version": "0.1.0",
  "description": "共同的努力：本机离线闯关打卡 PWA",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.21.0 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:qa": "VITE_QA_TOOLS=1 vite build",
    "preview": "vite preview",
    "preview:qa": "VITE_QA_TOOLS=1 vite build && vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license-check": "license-compliance --report detailed",
    "cap:sync": "cap sync android",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "canvas-confetti": "1.9.4",
    "dexie": "4.4.7",
    "dexie-export-import": "4.4.2",
    "dexie-react-hooks": "4.4.0",
    "ical-generator": "11.1.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "timezones-ical-library": "3.0.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "license-compliance": "4.0.0",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-build": "7.4.1"
  }
}
